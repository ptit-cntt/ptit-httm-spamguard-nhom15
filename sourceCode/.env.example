# Sao chép thành .env và đổi giá trị trước khi chạy docker compose
ADMIN_TOKEN=change-me-to-a-long-random-string
# Tài khoản đăng nhập Web Admin (tạm cố định, sẽ thay bằng cơ chế quản lý user sau)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
POSTGRES_USER=spamguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spamguard
GRAFANA_ADMIN_PASSWORD=change-me
# Chu kỳ chạy job feedback loop (giây)
RETRAIN_INTERVAL_SECONDS=86400
